# Virtual alias maps lookup for +tag subaddressing (MySQL)
# Rendered from this template by the container entrypoint (envsubst).

hosts = ${DB_HOST}
user = ${DB_USER}
password = ${DB_PASSWORD}
dbname = ${DB_NAME}

# Maps user+tag@domain to user@domain
query = SELECT CONCAT(u.local_part, '@', d.name) FROM users u JOIN domains d ON u.domain_id = d.id WHERE u.local_part = '%u' AND d.name = '%d' AND u.frozen = false
